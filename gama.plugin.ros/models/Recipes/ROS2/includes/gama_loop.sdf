<?xml version="1.0" ?>
<!--
  A world where Gazebo is the one deciding what actually happens.

  One differential-drive robot, with real wheels, real friction and real inertia, listening on
  /model/gama_bot/cmd_vel and reporting on /model/gama_bot/odometry. GAMA sends a command, the physics
  engine executes it as well as it can, and the odometry that comes back is the truth: it lags the
  command, overshoots it, and stops dead against a wall. That gap is the whole point of the model.

  Run with:
      gz sim -r gama_loop.sdf
-->
<sdf version="1.9">
  <world name="gama_loop">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacles. GAMA does not know they exist: it only finds out through the odometry, when the
         robot stops moving while still being told to go forward. -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.3 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12 0.3 1</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 0.3 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12 0.3 1</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 12 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 12 1</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 12 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 12 1</size></box></geometry>
          <material><ambient>0.45 0.45 0.5 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar">
      <static>true</static>
      <pose>2 2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.6</radius><length>1</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.6</radius><length>1</length></cylinder></geometry>
          <material><ambient>0.8 0.4 0.2 1</ambient><diffuse>0.8 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- The robot. Wheel separation and radius below must match what the DiffDrive plugin is told,
         otherwise the odometry it computes will not describe the motion it produces. -->
    <model name="gama_bot">
      <pose>0 0 0.15 0 0 0</pose>

      <link name="chassis">
        <pose>0 0 0.05 0 0 0</pose>
        <inertial>
          <mass>4.0</mass>
          <inertia><ixx>0.06</ixx><iyy>0.10</iyy><izz>0.14</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><box><size>0.6 0.36 0.16</size></box></geometry>
          <material><ambient>0.2 0.4 0.75 1</ambient><diffuse>0.2 0.4 0.75 1</diffuse></material>
        </visual>
        <visual name="nose">
          <pose>0.32 0 0 0 0 0</pose>
          <geometry><box><size>0.08 0.1 0.1</size></box></geometry>
          <material><ambient>0.95 0.85 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.6 0.36 0.16</size></box></geometry>
        </collision>
      </link>

      <link name="left_wheel">
        <pose>0 0.22 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.0015</ixx><iyy>0.0015</iyy><izz>0.0025</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>0.06</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          </surface>
        </collision>
      </link>

      <link name="right_wheel">
        <pose>0 -0.22 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.0015</ixx><iyy>0.0015</iyy><izz>0.0025</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>0.06</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
          </surface>
        </collision>
      </link>

      <!-- A frictionless ball to hold the back up, standing in for a caster -->
      <link name="caster">
        <pose>-0.25 0 -0.05 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <visual name="visual">
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction>
          </surface>
        </collision>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
      </joint>

      <joint name="caster_joint" type="ball">
        <parent>chassis</parent>
        <child>caster</child>
      </joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.44</wheel_separation>
        <wheel_radius>0.15</wheel_radius>
        <odom_publish_frequency>30</odom_publish_frequency>
        <topic>/model/gama_bot/cmd_vel</topic>
        <odom_topic>/model/gama_bot/odometry</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <!-- Deliberately gentle, so that the lag between what GAMA asks and what the robot does is
             visible in the charts rather than instantaneous -->
        <max_linear_acceleration>1.0</max_linear_acceleration>
        <min_linear_acceleration>-1.0</min_linear_acceleration>
      </plugin>

  <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
    <pose_publish_frequency>30</pose_publish_frequency>
    <publish_model_pose>true</publish_model_pose>
    <publish_link_pose>false</publish_link_pose>
    <use_pose_vector_msg>false</use_pose_vector_msg>
    <topic>/model/gama_bot/pose</topic>
  </plugin>


    </model>

  </world>
</sdf>
