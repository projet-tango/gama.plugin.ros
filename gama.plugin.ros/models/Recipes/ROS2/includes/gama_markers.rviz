# RViz2 configuration for "05 GAMA in RViz".
#
#   rviz2 -d gama_markers.rviz
#
# Fixed Frame is "map", which GAMA makes exist by publishing one transform map -> gama_world on /tf.
# Without that transform RViz has no frame to resolve markers against and draws nothing.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /GAMA agents1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: map
      Color: 160; 160; 164
    - Class: rviz_default_plugins/MarkerArray
      Name: GAMA agents
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /gama/markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 2
      Show Names: true
      Show Axes: true
      Show Arrows: false
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 55
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.0
      Yaw: 4.7124
      Target Frame: map
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
  Displays:
    collapsed: false
  Views:
    collapsed: false
